APP_NAME=CPBooke
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpbooke
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passenger API password-reset OTP
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_THROTTLE_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Passenger profile OTP / avatar
PROFILE_OTP_LENGTH=6
PROFILE_OTP_EXPIRE_MINUTES=10
PROFILE_OTP_MAX_ATTEMPTS=5
PROFILE_OTP_RESEND_THROTTLE_SECONDS=60
PROFILE_AVATAR_MAX_KB=2048

# Passenger API access/refresh token TTLs (seconds)
API_ACCESS_TOKEN_TTL_SECONDS=3600
API_ACCESS_TOKEN_REMEMBER_TTL_SECONDS=604800
API_REFRESH_TOKEN_TTL_SECONDS=604800
API_REFRESH_TOKEN_REMEMBER_TTL_SECONDS=2592000

# Push notifications — prefer Firebase Admin SDK service account (HTTP v1)
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
# Legacy optional (unused when credentials file exists)
FCM_SERVER_KEY=
FCM_SENDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ADMIN_NAME="Booke Admin"
ADMIN_EMAIL=admin@booke.local
ADMIN_PASSWORD=ChangeMe123!

# Support attachments (private disk + temporary signed download URLs)
SUPPORT_ATTACHMENT_MAX_KB=20480
SUPPORT_ATTACHMENT_SIGNED_URL_TTL=30

# SMS / WhatsApp notification gateways (leave empty to simulate in non-production)
SMS_ENDPOINT=
SMS_TOKEN=
WHATSAPP_ENDPOINT=
WHATSAPP_TOKEN=

# Provider wallets: true = allow overdraft, false = reject debit when funds are insufficient
WALLET_ALLOW_NEGATIVE=false
WALLET_DEFAULT_ENVIRONMENT=production

# Customer wallets — test top-up API for mobile app (disable in production)
WALLET_TEST_MODE=false
WALLET_TEST_TOP_UP_MAX=1000
WALLET_TEST_TOP_UP_MIN=1
CUSTOMER_WALLET_DEFAULT_CURRENCY=LYD

# Provider API configuration
PROVIDER_API_DEFAULT_TIMEOUT=30
PROVIDER_API_CONNECTION_TEST_PATH=/
PROVIDER_API_KEY_HEADER=X-API-Key

# Approval engine thresholds (default currency context: LYD)
APPROVAL_REFUND_DIRECT_THRESHOLD=100
APPROVAL_REFUND_FULL_AFTER_HOURS=24

# Settlement engine
SETTLEMENT_COST_TOLERANCE=0.01
SETTLEMENT_DEFAULT_CURRENCY=LYD

# Provider Health NOC thresholds
PROVIDER_HEALTH_WALLET_CRITICAL=500
PROVIDER_HEALTH_API_OFFLINE_MINUTES=10
PROVIDER_HEALTH_ERROR_RATE_WARN=5
PROVIDER_HEALTH_ERROR_RATE_CRITICAL=15
PROVIDER_HEALTH_FAILED_OPS_CRITICAL=20
PROVIDER_HEALTH_LATENCY_DEGRADED_MS=2000

# Monitoring / observability
MONITORING_SLOW_REQUEST_MS=1500
MONITORING_QUEUE_PENDING_WARN=50
MONITORING_QUEUE_PENDING_CRITICAL=200
MONITORING_FAILED_JOBS_WARN=5
MONITORING_FAILED_JOBS_CRITICAL=20
MONITORING_APPROVAL_EXPIRE_HOURS=72
MONITORING_EVENTS_RETENTION_DAYS=30
MONITORING_HEALTH_RETENTION_DAYS=14
MONITORING_API_EVENTS_RETENTION_DAYS=30
MONITORING_APPROVALS_ASYNC=false

# Audit / search
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=180
AUDIT_TIMELINE_LIMIT=100
AUDIT_SEARCH_LIMIT_PER_GROUP=10

# AI Travel Assistant (Google Gemini — Free Tier preferred)
# Key stays on the Laravel backend only. Never ship to Flutter.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_TIMEZONE=Africa/Tripoli
AI_DEFAULT_CURRENCY=LYD
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=12
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OFFERS=8
GEMINI_MAX_CONVERSATION_TURNS=6
AI_LOG_REQUESTS=true
AI_LOG_RETENTION_DAYS=90
# Windows/local PHP SSL: bundled CA at storage/certs/cacert.pem (auto-used if present)
# GEMINI_CA_BUNDLE="${PWD}/storage/certs/cacert.pem"
# Last resort local dev only: GEMINI_SSL_VERIFY=false
